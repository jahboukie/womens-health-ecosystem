/**
 * 🧪 LESSON 1: Our First Test!
 *
 * This file tests our ChatConversationScreen to make sure:
 * 1. Messages display in the correct order (newest at bottom)
 * 2. Timestamps show correctly (or "Now" if missing)
 * 3. The chat interface renders properly
 *
 * Think of this as a "quality inspector" for our chat feature!
 */

import React from 'react';
import { render, screen } from '@testing-library/react-native';
import { Provider } from 'react-redux';
import { configureStore } from '@reduxjs/toolkit';
import ChatConversationScreen from '../ChatConversationScreen';
import conversationsSlice from '../../../store/slices/conversationsSlice';

// 🎭 MOCK DATA: We create fake data to test with
const mockMessages = [
  {
    id: '1',
    content: 'Hello, I need some support today.',
    role: 'user',
    timestamp: '2024-01-01T10:00:00Z',
    conversationId: 'test-conversation'
  },
  {
    id: '2',
    content: 'I understand you\'re looking for support. I\'m here to help.',
    role: 'assistant',
    timestamp: '2024-01-01T10:01:00Z',
    conversationId: 'test-conversation'
  },
  {
    id: '3',
    content: 'Thank you, that means a lot.',
    role: 'user',
    timestamp: '2024-01-01T10:02:00Z',
    conversationId: 'test-conversation'
  }
];

// 🏪 MOCK STORE: We create a fake Redux store for testing
const createMockStore = (messages: any[] = []) => {
  return configureStore({
    reducer: {
      conversations: conversationsSlice
    },
    preloadedState: {
      conversations: {
        messages,
        loading: false,
        error: null,
        currentConversation: null,
        conversations: []
      }
    }
  });
};

// 🎬 HELPER FUNCTION: Renders our component with all the setup it needs
const renderChatScreen = (messages: any[] = []) => {
  const store = createMockStore(messages);
  return render(
    <Provider store={store}>
      <ChatConversationScreen />
    </Provider>
  );
};

// 🧪 THE ACTUAL TESTS START HERE!
describe('ChatConversationScreen', () => {

  // ✅ TEST 1: Basic rendering
  it('should render the chat screen without crashing', () => {
    // WHAT THIS DOES: Makes sure our component loads without errors
    // WHY IT'S IMPORTANT: If this fails, something is very wrong!

    renderChatScreen();

    // Look for the text input where users type messages
    expect(screen.getByPlaceholderText('Type your message...')).toBeTruthy();
  });

  // ✅ TEST 2: Message ordering (our recent fix!)
  it('should display messages in correct order (newest at bottom)', () => {
    // WHAT THIS DOES: Verifies our chat ordering fix works
    // WHY IT'S IMPORTANT: Users expect newest messages at the bottom

    renderChatScreen(mockMessages);

    // Get all message elements
    const messageElements = screen.getAllByTestId(/message-/);

    // Check that we have the right number of messages
    expect(messageElements).toHaveLength(3);

    // The messages should appear in chronological order
    // (This tests our fix where we removed inverted={true})
    expect(messageElements[0]).toHaveTextContent('Hello, I need some support today.');
    expect(messageElements[1]).toHaveTextContent('I understand you\'re looking for support.');
    expect(messageElements[2]).toHaveTextContent('Thank you, that means a lot.');
  });

  // ✅ TEST 3: Timestamp safety (our crash fix!)
  it('should handle missing timestamps gracefully', () => {
    // WHAT THIS DOES: Tests our timestamp safety check
    // WHY IT'S IMPORTANT: Prevents crashes when timestamps are missing

    const messageWithoutTimestamp = {
      id: '4',
      content: 'Message without timestamp',
      role: 'user',
      conversationId: 'test-conversation'
      // Notice: no timestamp property!
    };

    renderChatScreen([messageWithoutTimestamp]);

    // Should show "Now" instead of crashing
    expect(screen.getByText('Now')).toBeTruthy();
  });

  // ✅ TEST 4: User vs Assistant message styling
  it('should style user and assistant messages differently', () => {
    // WHAT THIS DOES: Makes sure different message types look different
    // WHY IT'S IMPORTANT: Users need to distinguish their messages from AI responses

    renderChatScreen(mockMessages);

    // Check that user and assistant messages exist
    expect(screen.getByText('Hello, I need some support today.')).toBeTruthy();
    expect(screen.getByText('I understand you\'re looking for support.')).toBeTruthy();
  });
});

/**
 * 🎓 LEARNING NOTES:
 *
 * 1. **describe()** - Groups related tests together
 * 2. **it()** - Defines a single test case
 * 3. **expect()** - Checks if something is true
 * 4. **render()** - Creates a virtual version of our component
 * 5. **screen.getBy...()** - Finds elements in our component
 *
 * 🎯 WHAT WE'RE TESTING:
 * - Does the component load without errors?
 * - Are messages in the right order?
 * - Do missing timestamps get handled safely?
 * - Do different message types display correctly?
 *
 * 🚀 WHY THIS MATTERS:
 * These tests will catch bugs before users see them!
 */
