/**
 * 🧪 ENCRYPTION SERVICE TESTS
 *
 * Comprehensive testing for enterprise-grade encryption:
 * 1. Key generation and management
 * 2. Encryption/decryption cycles
 * 3. Security validation
 * 4. Error handling
 * 5. Edge cases and attack scenarios
 *
 * Think of this as the security audit for our encryption!
 */

// Mock native dependencies
jest.mock('react-native-keychain', () => ({
  setInternetCredentials: jest.fn(),
  getInternetCredentials: jest.fn(),
  resetInternetCredentials: jest.fn(),
  ACCESS_CONTROL: {
    BIOMETRY_CURRENT_SET_OR_DEVICE_PASSCODE: 'BiometryCurrentSetOrDevicePasscode',
  },
  STORAGE_TYPE: {
    KC: 'KC',
  },
}));

jest.mock('crypto-js', () => ({
  lib: {
    WordArray: {
      random: jest.fn(() => ({
        toString: () => 'mock-random-string-12345',
      })),
    },
  },
  PBKDF2: jest.fn(() => 'mock-derived-key'),
  AES: {
    encrypt: jest.fn(() => ({
      ciphertext: { toString: () => 'mock-encrypted-data' },
      tag: { toString: () => 'mock-auth-tag' },
    })),
    decrypt: jest.fn(() => ({
      toString: jest.fn(() => 'decrypted-plaintext'),
    })),
  },
  mode: { GCM: 'GCM' },
  pad: { NoPadding: 'NoPadding' },
  algo: { SHA256: 'SHA256' },
  enc: {
    Hex: {
      parse: jest.fn(() => 'mock-parsed-hex'),
    },
    Utf8: 'Utf8',
  },
}));

const mockKeychain = require('react-native-keychain');
const mockCrypto = require('crypto-js');

// Import after mocking
const { EncryptionService } = require('../encryptionService');

describe('EncryptionService - Enterprise Security Tests', () => {

  beforeEach(() => {
    // Reset all mocks
    jest.clearAllMocks();
  });

  // ✅ TEST GROUP 1: Key Management
  describe('Master Key Management', () => {
    it('should generate new master key when none exists', async () => {
      // WHAT THIS DOES: Tests initial key generation
      // WHY IT'S IMPORTANT: First-time users need secure key generation

      mockKeychain.getInternetCredentials.mockResolvedValue(false);
      mockKeychain.setInternetCredentials.mockResolvedValue(true);

      const masterKey = await EncryptionService.generateMasterKey();

      expect(masterKey).toBeDefined();
      expect(mockKeychain.setInternetCredentials).toHaveBeenCalledWith(
        'soberpal_master_key',
        'soberpal_encryption',
        expect.any(String),
        expect.objectContaining({
          accessControl: 'BiometryCurrentSetOrDevicePasscode',
          service: 'SoberPal_Encryption',
        })
      );
    });

    it('should return existing master key when available', async () => {
      // WHAT THIS DOES: Tests key retrieval for existing users
      // WHY IT'S IMPORTANT: Returning users should get their existing key

      const existingKey = 'existing-master-key-12345';
      mockKeychain.getInternetCredentials.mockResolvedValue({
        password: existingKey,
      });

      const masterKey = await EncryptionService.generateMasterKey();

      expect(masterKey).toBe(existingKey);
      expect(mockKeychain.setInternetCredentials).not.toHaveBeenCalled();
    });

    it('should handle key generation errors gracefully', async () => {
      // WHAT THIS DOES: Tests error handling in key generation
      // WHY IT'S IMPORTANT: Encryption failures should be handled safely

      mockKeychain.getInternetCredentials.mockRejectedValue(new Error('Keychain error'));
      mockKeychain.setInternetCredentials.mockRejectedValue(new Error('Keychain write error'));

      await expect(EncryptionService.generateMasterKey()).rejects.toThrow('Encryption key generation failed');
    });
  });

  // ✅ TEST GROUP 2: Encryption Operations
  describe('Data Encryption', () => {
    it('should encrypt data successfully', async () => {
      // WHAT THIS DOES: Tests basic encryption functionality
      // WHY IT'S IMPORTANT: Core encryption must work reliably

      mockKeychain.getInternetCredentials.mockResolvedValue({
        password: 'test-master-key',
      });

      const plaintext = 'Sensitive recovery data';
      const encrypted = await EncryptionService.encryptData(plaintext);

      expect(encrypted).toHaveProperty('encryptedData');
      expect(encrypted).toHaveProperty('iv');
      expect(encrypted).toHaveProperty('salt');
      expect(encrypted).toHaveProperty('tag');
      expect(mockCrypto.AES.encrypt).toHaveBeenCalled();
    });

    it('should generate unique IV and salt for each encryption', async () => {
      // WHAT THIS DOES: Tests that each encryption uses unique parameters
      // WHY IT'S IMPORTANT: Prevents rainbow table and replay attacks

      mockKeychain.getInternetCredentials.mockResolvedValue({
        password: 'test-master-key',
      });

      const plaintext = 'Test data';

      // Mock different random values for each call
      let callCount = 0;
      mockCrypto.lib.WordArray.random.mockImplementation(() => ({
        toString: () => `random-${++callCount}`,
      }));

      const encrypted1 = await EncryptionService.encryptData(plaintext);
      const encrypted2 = await EncryptionService.encryptData(plaintext);

      expect(encrypted1.iv).not.toBe(encrypted2.iv);
      expect(encrypted1.salt).not.toBe(encrypted2.salt);
    });

    it('should handle encryption errors', async () => {
      // WHAT THIS DOES: Tests encryption error handling
      // WHY IT'S IMPORTANT: Encryption failures should be caught and reported

      // Mock both key retrieval failure AND encryption failure
      mockKeychain.getInternetCredentials.mockRejectedValue(new Error('Key not found'));
      mockKeychain.setInternetCredentials.mockRejectedValue(new Error('Key generation failed'));

      await expect(EncryptionService.encryptData('test')).rejects.toThrow('Data encryption failed');
    });
  });

  // ✅ TEST GROUP 3: Decryption Operations
  describe('Data Decryption', () => {
    it('should decrypt data successfully', async () => {
      // WHAT THIS DOES: Tests basic decryption functionality
      // WHY IT'S IMPORTANT: Users must be able to access their encrypted data

      mockKeychain.getInternetCredentials.mockResolvedValue({
        password: 'test-master-key',
      });

      const encryptedData = {
        encryptedData: 'mock-encrypted-data',
        iv: 'mock-iv',
        salt: 'mock-salt',
        tag: 'mock-tag',
      };

      const decrypted = await EncryptionService.decryptData(encryptedData);

      expect(decrypted).toBe('decrypted-plaintext');
      expect(mockCrypto.AES.decrypt).toHaveBeenCalled();
    });

    it('should fail decryption with wrong key', async () => {
      // WHAT THIS DOES: Tests that wrong keys can't decrypt data
      // WHY IT'S IMPORTANT: Ensures data security against unauthorized access

      mockKeychain.getInternetCredentials.mockResolvedValue(null);

      const encryptedData = {
        encryptedData: 'mock-encrypted-data',
        iv: 'mock-iv',
        salt: 'mock-salt',
        tag: 'mock-tag',
      };

      await expect(EncryptionService.decryptData(encryptedData)).rejects.toThrow('Master key not found');
    });

    it('should handle decryption errors', async () => {
      // WHAT THIS DOES: Tests decryption error handling
      // WHY IT'S IMPORTANT: Corrupted data should be handled gracefully

      mockKeychain.getInternetCredentials.mockResolvedValue({
        password: 'test-master-key',
      });

      mockCrypto.AES.decrypt.mockImplementation(() => {
        throw new Error('Decryption failed');
      });

      const encryptedData = {
        encryptedData: 'corrupted-data',
        iv: 'mock-iv',
        salt: 'mock-salt',
        tag: 'mock-tag',
      };

      await expect(EncryptionService.decryptData(encryptedData)).rejects.toThrow('Data decryption failed');
    });
  });

  // ✅ TEST GROUP 4: Security Operations
  describe('Security Operations', () => {
    it('should validate encryption system', async () => {
      // WHAT THIS DOES: Tests encryption system validation
      // WHY IT'S IMPORTANT: System should self-validate for security assurance

      mockKeychain.getInternetCredentials.mockResolvedValue({
        password: 'test-master-key',
      });

      // Mock successful encryption/decryption cycle that returns the same test data
      const testData = 'SoberPal_Encryption_Test_12345';
      mockCrypto.AES.decrypt.mockReturnValue({
        toString: jest.fn(() => testData),
      });

      const isValid = await EncryptionService.validateEncryption();

      expect(isValid).toBe(true);
    });

    it('should rotate keys successfully', async () => {
      // WHAT THIS DOES: Tests key rotation for Perfect Forward Secrecy
      // WHY IT'S IMPORTANT: Regular key rotation improves security

      // Reset mocks to ensure clean state
      jest.clearAllMocks();

      mockKeychain.resetInternetCredentials.mockResolvedValue(true);
      mockKeychain.getInternetCredentials.mockResolvedValue(false); // No existing key
      mockKeychain.setInternetCredentials.mockResolvedValue(true);

      await expect(EncryptionService.rotateKeys()).resolves.not.toThrow();

      expect(mockKeychain.resetInternetCredentials).toHaveBeenCalledWith('soberpal_master_key');
      expect(mockKeychain.setInternetCredentials).toHaveBeenCalled();
    });

    it('should clear all keys securely', async () => {
      // WHAT THIS DOES: Tests secure key deletion
      // WHY IT'S IMPORTANT: Users should be able to securely remove all data

      mockKeychain.resetInternetCredentials.mockResolvedValue(true);

      await expect(EncryptionService.clearAllKeys()).resolves.not.toThrow();

      expect(mockKeychain.resetInternetCredentials).toHaveBeenCalledWith('soberpal_master_key');
    });
  });

  // ✅ TEST GROUP 5: Edge Cases and Security
  describe('Edge Cases and Security', () => {
    it('should handle empty data encryption', async () => {
      // WHAT THIS DOES: Tests encryption of empty strings
      // WHY IT'S IMPORTANT: Edge cases should be handled gracefully

      mockKeychain.getInternetCredentials.mockResolvedValue({
        password: 'test-master-key',
      });

      const encrypted = await EncryptionService.encryptData('');

      expect(encrypted).toHaveProperty('encryptedData');
      expect(mockCrypto.AES.encrypt).toHaveBeenCalled();
    });

    it('should handle large data encryption', async () => {
      // WHAT THIS DOES: Tests encryption of large data sets
      // WHY IT'S IMPORTANT: Large therapy sessions should be encrypted efficiently

      mockKeychain.getInternetCredentials.mockResolvedValue({
        password: 'test-master-key',
      });

      const largeData = 'A'.repeat(10000); // 10KB of data
      const encrypted = await EncryptionService.encryptData(largeData);

      expect(encrypted).toHaveProperty('encryptedData');
      expect(mockCrypto.AES.encrypt).toHaveBeenCalled();
    });

    it('should handle special characters in data', async () => {
      // WHAT THIS DOES: Tests encryption of special characters and unicode
      // WHY IT'S IMPORTANT: International users and special characters should work

      mockKeychain.getInternetCredentials.mockResolvedValue({
        password: 'test-master-key',
      });

      const specialData = '🔐 Special chars: àáâãäå ñ 中文 العربية 🚀';
      const encrypted = await EncryptionService.encryptData(specialData);

      expect(encrypted).toHaveProperty('encryptedData');
      expect(mockCrypto.AES.encrypt).toHaveBeenCalled();
    });
  });
});

