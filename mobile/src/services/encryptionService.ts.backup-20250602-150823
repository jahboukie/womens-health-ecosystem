import CryptoJS from 'crypto-js';
import * as Keychain from 'react-native-keychain';

interface EncryptedData {
  encryptedData: string;
  iv: string;
  salt: string;
  tag: string;
}

interface KeyPair {
  publicKey: string;
  privateKey: string;
}

export class EncryptionService {
  private static readonly MASTER_KEY_ALIAS = 'soberpal_master_key';
  private static readonly KEY_SIZE = 256; // AES-256
  private static readonly IV_SIZE = 16; // 128-bit IV
  private static readonly SALT_SIZE = 32; // 256-bit salt

  // 🔑 MASTER KEY MANAGEMENT: Secure key generation and storage
  static async generateMasterKey(): Promise<string> {
    try {
      // Check if master key already exists
      const existingKey = await this.getMasterKey();
      if (existingKey) {
        return existingKey;
      }

      // Generate new 256-bit master key
      const masterKey = CryptoJS.lib.WordArray.random(this.KEY_SIZE / 8).toString();
      
      // Store securely in device keychain
      await Keychain.setInternetCredentials(
        this.MASTER_KEY_ALIAS,
        'soberpal_encryption',
        masterKey,
        {
          accessControl: Keychain.ACCESS_CONTROL.BIOMETRY_CURRENT_SET_OR_DEVICE_PASSCODE,
          authenticatePrompt: 'Authenticate to access your encrypted data',
          service: 'SoberPal_Encryption',
          storage: Keychain.STORAGE_TYPE.KC, // Use Keychain (most secure)
        }
      );

      return masterKey;
    } catch (error) {
      console.error('Failed to generate master key:', error);
      throw new Error('Encryption key generation failed');
    }
  }

  // 🔓 SECURE KEY RETRIEVAL: Get master key from secure storage
  static async getMasterKey(): Promise<string | null> {
    try {
      const credentials = await Keychain.getInternetCredentials(this.MASTER_KEY_ALIAS);
      
      if (credentials && credentials.password) {
        return credentials.password;
      }
      
      return null;
    } catch (error) {
      console.error('Failed to retrieve master key:', error);
      return null;
    }
  }

  // 🔒 MESSAGE ENCRYPTION: Encrypt sensitive data with AES-256-GCM
  static async encryptData(plaintext: string, additionalData?: string): Promise<EncryptedData> {
    try {
      const masterKey = await this.generateMasterKey();
      
      // Generate random salt and IV for this encryption
      const salt = CryptoJS.lib.WordArray.random(this.SALT_SIZE / 8);
      const iv = CryptoJS.lib.WordArray.random(this.IV_SIZE / 8);
      
      // Derive encryption key using PBKDF2
      const derivedKey = CryptoJS.PBKDF2(masterKey, salt, {
        keySize: this.KEY_SIZE / 32,
        iterations: 100000, // High iteration count for security
        hasher: CryptoJS.algo.SHA256
      });

      // Encrypt using AES-256-GCM (provides both confidentiality and authenticity)
      const encrypted = CryptoJS.AES.encrypt(plaintext, derivedKey, {
        iv: iv,
        mode: CryptoJS.mode.GCM,
        padding: CryptoJS.pad.NoPadding
      });

      return {
        encryptedData: encrypted.ciphertext.toString(),
        iv: iv.toString(),
        salt: salt.toString(),
        tag: encrypted.tag?.toString() || '', // Authentication tag for GCM
      };
    } catch (error) {
      console.error('Encryption failed:', error);
      throw new Error('Data encryption failed');
    }
  }

  // 🔓 MESSAGE DECRYPTION: Decrypt data with authentication verification
  static async decryptData(encryptedData: EncryptedData): Promise<string> {
    try {
      const masterKey = await this.getMasterKey();
      if (!masterKey) {
        throw new Error('Master key not found');
      }

      // Recreate the derived key using stored salt
      const salt = CryptoJS.enc.Hex.parse(encryptedData.salt);
      const derivedKey = CryptoJS.PBKDF2(masterKey, salt, {
        keySize: this.KEY_SIZE / 32,
        iterations: 100000,
        hasher: CryptoJS.algo.SHA256
      });

      // Decrypt using AES-256-GCM
      const iv = CryptoJS.enc.Hex.parse(encryptedData.iv);
      const ciphertext = CryptoJS.enc.Hex.parse(encryptedData.encryptedData);
      
      const decrypted = CryptoJS.AES.decrypt(
        {
          ciphertext: ciphertext,
          tag: CryptoJS.enc.Hex.parse(encryptedData.tag)
        } as any,
        derivedKey,
        {
          iv: iv,
          mode: CryptoJS.mode.GCM,
          padding: CryptoJS.pad.NoPadding
        }
      );

      return decrypted.toString(CryptoJS.enc.Utf8);
    } catch (error) {
      console.error('Decryption failed:', error);
      throw new Error('Data decryption failed');
    }
  }

  // 🔄 KEY ROTATION: Rotate encryption keys for Perfect Forward Secrecy
  static async rotateKeys(): Promise<void> {
    try {
      // Remove old master key
      await Keychain.resetInternetCredentials(this.MASTER_KEY_ALIAS);
      
      // Generate new master key
      await this.generateMasterKey();
      
      console.log('Encryption keys rotated successfully');
    } catch (error) {
      console.error('Key rotation failed:', error);
      throw new Error('Key rotation failed');
    }
  }

  // 🗑️ SECURE CLEANUP: Securely delete all encryption keys
  static async clearAllKeys(): Promise<void> {
    try {
      await Keychain.resetInternetCredentials(this.MASTER_KEY_ALIAS);
      console.log('All encryption keys cleared');
    } catch (error) {
      console.error('Failed to clear keys:', error);
      throw new Error('Key cleanup failed');
    }
  }

  // 🔍 SECURITY VALIDATION: Verify encryption system integrity
  static async validateEncryption(): Promise<boolean> {
    try {
      const testData = 'SoberPal_Encryption_Test_' + Date.now();
      
      // Test encryption/decryption cycle
      const encrypted = await this.encryptData(testData);
      const decrypted = await this.decryptData(encrypted);
      
      return decrypted === testData;
    } catch (error) {
      console.error('Encryption validation failed:', error);
      return false;
    }
  }
}

export default EncryptionService;

