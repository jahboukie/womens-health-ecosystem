/**
 * 🧪 LESSON 4: Testing Redux State Management
 *
 * This file tests our authentication Redux slice to make sure:
 * 1. Initial state is correct
 * 2. Login actions update state properly
 * 3. Logout actions clear state correctly
 * 4. Error handling works in state management
 * 5. Loading states are managed correctly
 *
 * Think of this as testing the "memory" of our authentication system!
 */

// 🎭 MOCK NATIVE DEPENDENCIES: React Native testing requires mocking native modules
jest.mock('@react-native-async-storage/async-storage', () => ({
  setItem: jest.fn(),
  getItem: jest.fn(),
  removeItem: jest.fn(),
}));

jest.mock('expo-secure-store', () => ({
  setItemAsync: jest.fn(),
  getItemAsync: jest.fn(),
  deleteItemAsync: jest.fn(),
}));

// Mock the auth service to avoid network dependencies
jest.mock('../../services/authService', () => ({
  authService: {
    login: jest.fn(),
    logout: jest.fn(),
    register: jest.fn(),
  }
}));

import authSlice, {
  clearError,
  setLoading,
  updateUser,
  clearAuth
} from '../slices/authSlice';

// 🧪 THE ACTUAL TESTS START HERE!
describe('authSlice', () => {

  // Test data
  const initialState = {
    isAuthenticated: false,
    user: null,
    token: null,
    isLoading: false,
    error: null,
  };

  const mockUser = {
    id: 'user-123',
    email: 'test@example.com',
    timezone: 'UTC',
    preferences: {
      notificationFrequency: 'daily',
      aiPersonality: 'supportive',
      crisisInterventionEnabled: true,
      dataRetentionDays: 30,
      shareProgressWithSupport: false,
      enableBiometricAuth: false,
    },
    accountStatus: 'active'
  };

  const mockToken = 'jwt-token-12345';

  // ✅ TEST GROUP 1: Initial State
  describe('Initial State', () => {
    it('should have correct initial state', () => {
      // WHAT THIS DOES: Tests that our Redux store starts with the right values
      // WHY IT'S IMPORTANT: Apps should start in a known, safe state

      const state = authSlice(undefined, { type: 'unknown' });

      expect(state).toEqual(initialState);
    });
  });

  // ✅ TEST GROUP 2: Synchronous Actions
  describe('Synchronous Actions', () => {
    it('should handle clearError', () => {
      // WHAT THIS DOES: Tests clearing error messages
      // WHY IT'S IMPORTANT: Users should be able to dismiss error messages

      const stateWithError = {
        ...initialState,
        error: 'Login failed'
      };

      const newState = authSlice(stateWithError, clearError());

      expect(newState.error).toBeNull();
    });

    it('should handle setLoading', () => {
      // WHAT THIS DOES: Tests setting loading state
      // WHY IT'S IMPORTANT: Users should see loading indicators

      const newState = authSlice(initialState, setLoading(true));

      expect(newState.isLoading).toBe(true);
    });

    it('should handle updateUser', () => {
      // WHAT THIS DOES: Tests updating user information
      // WHY IT'S IMPORTANT: User profiles can be updated

      const stateWithUser = {
        ...initialState,
        isAuthenticated: true,
        user: mockUser,
        token: mockToken
      };

      const updatedUserData = {
        ...mockUser,
        email: 'newemail@example.com'
      };

      const newState = authSlice(stateWithUser, updateUser(updatedUserData));

      expect(newState.user.email).toBe('newemail@example.com');
      expect(newState.user.id).toBe(mockUser.id); // Other fields preserved
    });

    it('should handle clearAuth', () => {
      // WHAT THIS DOES: Tests clearing all authentication data
      // WHY IT'S IMPORTANT: Logout should completely clear user data

      const authenticatedState = {
        isAuthenticated: true,
        user: mockUser,
        token: mockToken,
        isLoading: false,
        error: null
      };

      const newState = authSlice(authenticatedState, clearAuth());

      expect(newState).toEqual(initialState);
    });
  });

  // ✅ TEST GROUP 3: State Management Logic
  describe('State Management Logic', () => {
    it('should maintain state immutability', () => {
      // WHAT THIS DOES: Tests that Redux doesn't mutate the original state
      // WHY IT'S IMPORTANT: Redux requires immutable updates

      const originalState = { ...initialState };
      const newState = authSlice(initialState, setLoading(true));

      expect(initialState).toEqual(originalState); // Original unchanged
      expect(newState).not.toBe(initialState); // New object created
      expect(newState.isLoading).toBe(true);
    });

    it('should handle unknown actions gracefully', () => {
      // WHAT THIS DOES: Tests that unknown actions don't break the reducer
      // WHY IT'S IMPORTANT: Redux should be resilient to unexpected actions

      const unknownAction = { type: 'UNKNOWN_ACTION', payload: 'test' };
      const newState = authSlice(initialState, unknownAction);

      expect(newState).toEqual(initialState);
    });

    it('should preserve other state when updating specific fields', () => {
      // WHAT THIS DOES: Tests that updating one field doesn't affect others
      // WHY IT'S IMPORTANT: State updates should be surgical, not destructive

      const stateWithData = {
        isAuthenticated: true,
        user: mockUser,
        token: mockToken,
        isLoading: false,
        error: null
      };

      const newState = authSlice(stateWithData, setLoading(true));

      expect(newState.isLoading).toBe(true);
      expect(newState.isAuthenticated).toBe(true); // Preserved
      expect(newState.user).toEqual(mockUser); // Preserved
      expect(newState.token).toBe(mockToken); // Preserved
    });
  });
});

/**
 * 🎓 LEARNING NOTES:
 *
 * 1. **Redux Testing** - Test state changes, not implementation
 * 2. **Action Testing** - Test both sync and async actions
 * 3. **State Transitions** - Test how state changes over time
 * 4. **Error Handling** - Test both success and failure cases
 * 5. **Pure Functions** - Redux reducers are easy to test!
 *
 * 🎯 WHAT WE'RE TESTING:
 * - Does initial state start correctly?
 * - Do actions update state properly?
 * - Are loading states managed correctly?
 * - Does error handling work?
 * - Are state transitions logical?
 *
 * 🚀 WHY REDUX TESTING IS GREAT:
 * - **Pure functions** - Predictable input/output
 * - **No side effects** - Easy to test in isolation
 * - **Clear state changes** - Easy to verify
 * - **No mocking needed** - Test the real reducer
 *
 * 💡 KEY INSIGHT:
 * Redux testing is much easier than API testing because:
 * - No external dependencies
 * - Pure functions with predictable behavior
 * - Clear input/output relationships
 * - No complex mocking required
 */
