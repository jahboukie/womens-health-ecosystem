{
  "name": "@womens-health-ecosystem/ecosystem-integration",
  "version": "1.0.0",
  "description": "Unified ecosystem integration for cross-app intelligence and data sharing",
  "main": "index.js",
  "type": "module",
  "private": true,
  "keywords": [
    "ecosystem",
    "integration",
    "analytics",
    "sentiment-analysis",
    "privacy",
    "healthcare",
    "cross-app",
    "intelligence"
  ],
  "author": "Women's Health Ecosystem Team",
  "license": "PROPRIETARY",
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "crypto": "^1.0.1",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "jest": "^29.7.0",
    "typescript": "^5.3.3"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .js,.ts",
    "validate-integration": "node scripts/validate-integration.js",
    "test-ecosystem-api": "node scripts/test-ecosystem-api.js",
    "privacy-compliance-check": "node scripts/privacy-compliance.js"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "**/*.{js,ts}",
      "!**/node_modules/**",
      "!**/coverage/**",
      "!**/scripts/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jahboukie/womens-health-ecosystem.git",
    "directory": "shared/ecosystem-integration"
  },
  "bugs": {
    "url": "https://github.com/jahboukie/womens-health-ecosystem/issues"
  },
  "homepage": "https://github.com/jahboukie/womens-health-ecosystem#readme",
  "files": [
    "*.js",
    "*.d.ts",
    "README.md"
  ],
  "publishConfig": {
    "access": "restricted"
  }
}
