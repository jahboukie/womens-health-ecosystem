{
  "name": "@womens-health-ecosystem/security",
  "version": "1.0.0",
  "description": "Military-Grade Security Foundation for Women's Health Ecosystem",
  "main": "index.js",
  "private": true,
  "keywords": [
    "security",
    "encryption",
    "hipaa",
    "healthcare",
    "compliance",
    "audit",
    "mfa",
    "zero-knowledge"
  ],
  "author": "Women's Health Ecosystem Security Team",
  "license": "PROPRIETARY",
  "dependencies": {
    "argon2": "^0.31.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "qrcode": "^1.5.3",
    "speakeasy": "^2.0.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.5",
    "@types/pg": "^8.10.9",
    "@types/qrcode": "^1.5.5",
    "@types/speakeasy": "^2.0.10",
    "@types/uuid": "^9.0.7",
    "jest": "^29.7.0",
    "typescript": "^5.3.3"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build": "tsc",
    "lint": "eslint . --ext .js,.ts",
    "security-audit": "npm audit --audit-level moderate",
    "validate-encryption": "node scripts/validate-encryption.js",
    "generate-keys": "node scripts/generate-keys.js",
    "compliance-check": "node scripts/compliance-check.js"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "**/*.{js,ts}",
      "!**/node_modules/**",
      "!**/coverage/**",
      "!**/scripts/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jahboukie/womens-health-ecosystem.git",
    "directory": "shared/security"
  },
  "bugs": {
    "url": "https://github.com/jahboukie/womens-health-ecosystem/issues"
  },
  "homepage": "https://github.com/jahboukie/womens-health-ecosystem#readme",
  "files": [
    "*.js",
    "*.d.ts",
    "README.md",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "restricted"
  }
}
